#!/usr/bin/env bash
#
# tcc — combined live monitor for the 白い熊 TUXEDO Control Center stack.
#
# Three columns, refreshed every second, in the current screen (the last frame
# stays on the terminal after quitting):
#
#   1. dashboard readings (CPU / dGPU / iGPU)  — what `tccinfo -m` shows
#   2. profile list                             — p  switches a profile (like `tccprofile N`)
#   3. Aquaris state                            — a  toggles cooling on/off
#                                                 f  edits fan % (Enter applies)
#                                                 l  toggles the LED
#                                                 s  switches the wall plug on/off
#   q quits.
#
# The plug (a Tasmota smart switch, IP from $KXTCC or ~/.kxrc) is the last resort
# for a wedged Aquaris: when it stops answering over BLE the keeper cycles the
# plug to kill it. The plug goes straight back on — the laptop is charged through
# the same chain — so a normal-looking ON plug can still mean a dead cooler. The
# frame banners both cases: plug OFF, and "keeper cut a wedged unit, press its
# front button", the latter read from keeper-state.json.
#
# On terminals narrower than the full 86-column frame (e.g. 58-column SSH
# sessions) a narrow layout is used automatically: dashboard | profiles side
# by side, Aquaris stacked below, one-line key footer. The width is re-read
# every frame, so resizing switches layouts live. Force a layout with
# `tcc -n|--narrow` or `tcc -w|--wide`.
#
set -uo pipefail

BUS=com.tuxedocomputers.tccd
OBJ=/com/tuxedocomputers/tccd
INTERVAL=1
W1=26; W2=24; W3=28           # column widths (characters)
FULL_W=$(( 2 + W1 + 3 + W2 + 3 + W3 ))   # total width of the wide frame

MODE=auto
case "${1-}" in
    '')          ;;
    -n|--narrow) MODE=narrow;;
    -w|--wide)   MODE=wide;;
    -h|--help)   printf 'usage: tcc [-n|--narrow | -w|--wide]\n'; exit 0;;
    *)           printf 'tcc: unknown option: %s\n' "$1" >&2; exit 1;;
esac

SELF_DIR=$(dirname "$(readlink -f "$0")")
AQ_CFG="$HOME/.config/tccaquaris"
AQ_DESIRED="$AQ_CFG/desired.json"
AQ_STATUS="$AQ_CFG/status.json"
AQ_KEEPER_STATE="$AQ_CFG/keeper-state.json"
AQ_SVC=tccaquaris-keeper.service

die() { printf 'tcc: %s\n' "$*" >&2; exit 1; }
command -v busctl >/dev/null || die "busctl not found"
command -v jq     >/dev/null || die "jq not found"
[ -t 0 ] && [ -t 1 ] || die "tcc needs an interactive terminal"

# ---- Tasmota plug (optional) -------------------------------------------------
# Same resolution order as the keeper: $KXTCC, else a KXTCC= line in ~/.kxrc.
# Absent or curl-less => every plug feature quietly disappears from the UI.
plug_ip() {
    local v="${KXTCC-}"
    if [ -z "$v" ] && [ -r "$HOME/.kxrc" ]; then
        v=$(sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?KXTCC=(.*)$/\2/p' "$HOME/.kxrc" | head -1)
        v=${v%%#*}; v=${v//\"/}; v=${v//\'/}
        v=$(printf '%s' "$v" | tr -d '[:space:]')
    fi
    printf '%s' "$v"
}
PLUG_IP=''
command -v curl >/dev/null && PLUG_IP=$(plug_ip)
PLUG_STATE=''        # ON | OFF | unreachable | '' (no plug)
PLUG_TS=0            # epoch s of the last poll; 0 forces a refresh
PLUG_POLL_SEC=5

dj() { busctl --json=short --system call "$BUS" "$OBJ" "$BUS" "$1" 2>/dev/null | jq -r '.data[0] // empty'; }
j()  { printf '%s' "$2" | jq -r "$1" 2>/dev/null; }

[ "$(busctl --json=short --system call "$BUS" "$OBJ" "$BUS" dbusAvailable 2>/dev/null | jq -r '.data[0] // false')" = "true" ] \
    || die "tccd not reachable on the system bus (is the daemon running?)"

# ---- formatting (same conventions as tccinfo) --------------------------------
USE_F=false
[ -r /etc/tcc/settings ] && USE_F=$(jq -r '.fahrenheit // false' /etc/tcc/settings 2>/dev/null)
temp() {
    local c="$1"
    case "$c" in ''|-1|-1.*) printf 'N/A'; return;; esac
    awk -v c="$c" -v f="$USE_F" 'BEGIN{ if(f=="true"){printf "%d °F", c*9/5+32} else {printf "%d °C", c} }'
}
pct()  { case "$1" in ''|-1|-1.*) printf 'N/A';; *) printf '%d %%' "$(LC_ALL=C printf '%.0f' "$1")";; esac; }   # LC_ALL=C: %.0f rejects "." floats under ja_JP
watt() { case "$1" in ''|-*) printf 'N/A';; *) printf '%d W' "$(LC_ALL=C printf '%.0f' "$1")";; esac; }   # any negative = invalid sample
mhz()  { case "$1" in ''|-1|-1.*|0) printf 'N/A';; *) awk -v v="$1" 'BEGIN{printf "%.2f GHz", v/1000}';; esac; }

# pad/truncate to a display width in characters (UTF-8-aware via ${#})
pad() {
    local s="${1-}" w="$2"
    s=${s:0:w}
    printf '%s%*s' "$s" $(( w - ${#s} )) ''
}

power_state() {
    local d
    for d in /sys/class/power_supply/*/; do
        [ "$(cat "$d/type" 2>/dev/null)" = "Mains" ] || continue
        [ "$(cat "$d/online" 2>/dev/null)" = "1" ] && { echo power_ac; return; }
    done
    echo power_bat
}

# ---- sensor collection keep-alive (see tccinfo) -------------------------------
PREV=$(busctl --json=short --system call "$BUS" "$OBJ" "$BUS" GetSensorDataCollectionStatus 2>/dev/null | jq -r '.data[0] // false')
sensors_on()      { busctl --system call "$BUS" "$OBJ" "$BUS" SetSensorDataCollectionStatus b true  >/dev/null 2>&1; }
sensors_restore() { [ "$PREV" = "true" ] || busctl --system call "$BUS" "$OBJ" "$BUS" SetSensorDataCollectionStatus b false >/dev/null 2>&1; }

# ---- data collection -----------------------------------------------------------
collect() {
    FAN=$(dj GetFanDataJSON)
    CPUPWR=$(dj GetCpuPowerValuesJSON)
    DGPU=$(dj GetDGpuInfoValuesJSON)
    IGPU=$(dj GetIGpuInfoValuesJSON)
    PROF=$(dj GetActiveProfileJSON)
    PROFILES=$(dj GetProfilesJSON)
    DGPU_AVAIL=$(busctl --json=short --system call "$BUS" "$OBJ" "$BUS" GetDGpuAvailable 2>/dev/null | jq -r '.data[0] // 0')

    ACTIVE_ID=$(j '.id // empty' "$PROF")
    POWER=$(power_state)

    CPU_TEMP=$(j '.cpu.temp.data'   "$FAN")
    CPU_FAN=$( j '.cpu.speed.data'  "$FAN")
    GPU_TEMP=$(j '.gpu1.temp.data'  "$FAN")
    GPU_FAN=$( j '.gpu1.speed.data' "$FAN")
    CPU_PDRAW=$(j '.powerDraw'      "$CPUPWR")
    CPU_PMAX=$( j '.maxPowerLimit'  "$CPUPWR")

    CPU_GHZ=$(awk '{s+=$1;n++} END{ if(n>0) printf "%.2f GHz", (s/n)/1e6; else print "N/A" }' \
        /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null)
    [ -n "$CPU_GHZ" ] || CPU_GHZ="N/A"

    DGPU_PDRAW=$(j '.powerDraw'      "$DGPU")
    DGPU_FREQ=$( j '.coreFrequency'  "$DGPU")
    IGPU_TEMP=$( j '.temp'           "$IGPU")
    IGPU_FREQ=$( j '.coreFrequency'  "$IGPU")
    IGPU_PDRAW=$(j '.powerDraw'      "$IGPU")

    collect_plug
}

# Polled here (the parent shell) rather than in the renderer, which runs in a
# command substitution where a cached value could never survive the frame.
collect_plug() {
    [ -n "$PLUG_IP" ] || return 0
    local now; now=$(date +%s)
    (( now - PLUG_TS < PLUG_POLL_SEC )) && return 0
    PLUG_TS=$now
    PLUG_STATE=$(curl -s -m 2 "http://$PLUG_IP/cm?cmnd=Power" 2>/dev/null | jq -r '.POWER // empty' 2>/dev/null)
    [ -n "$PLUG_STATE" ] || PLUG_STATE='unreachable'
}

# ---- column renderers (one line per output line) --------------------------------
render_dash() {
    printf 'CPU\n'
    printf '  Temp  : %s\n' "$(temp "$CPU_TEMP")"
    printf '  Fan   : %s\n' "$(pct  "$CPU_FAN")"
    printf '  Freq  : %s\n' "$CPU_GHZ"
    case "$CPU_PDRAW" in
        ''|-*) printf '  Power : N/A\n';;
        *)     printf '  Power : %s / %s\n' "$(watt "$CPU_PDRAW")" "$(watt "$CPU_PMAX")";;
    esac
    printf '\ndGPU\n'
    if [ "$DGPU_AVAIL" = "1" ]; then
        printf '  Temp  : %s\n' "$(temp "$GPU_TEMP")"
        printf '  Fan   : %s\n' "$(pct  "$GPU_FAN")"
        case "$DGPU_PDRAW" in
            ''|-*) printf '  Power : N/A  (off)\n  Freq  : N/A  (off)\n';;
            *)     printf '  Power : %s\n  Freq  : %s\n' "$(watt "$DGPU_PDRAW")" "$(mhz "$DGPU_FREQ")";;
        esac
    else
        printf '  not available\n'
    fi
    printf '\niGPU\n'
    printf '  Temp  : %s\n' "$(temp "$IGPU_TEMP")"
    printf '  Freq  : %s\n' "$(mhz  "$IGPU_FREQ")"
    printf '  Power : %s\n' "$(watt "$IGPU_PDRAW")"
}

render_profiles() {
    printf 'Profiles (%s)\n\n' "${POWER#power_}"
    printf '%s' "$PROFILES" | jq -r 'to_entries[] | "\(.key+1)\t\(.value.id)\t\(.value.name)"' 2>/dev/null |
    while IFS=$'\t' read -r n id name; do
        local mark='○'; [ "$id" = "$ACTIVE_ID" ] && mark='●'
        printf '%s %d %s\n' "$mark" "$n" "${name:0:$((W2-5))}"
    done
}

render_aquaris() {
    local fanOn ledOn fan r g b link owner conn auto wfan wled
    owner=$(jq -r '.owner // empty'     "$AQ_STATUS" 2>/dev/null)
    conn=$( jq -r '.connected // false' "$AQ_STATUS" 2>/dev/null)

    if systemctl --user is-active --quiet "$AQ_SVC" 2>/dev/null; then
        if   [ "$owner" = "gui" ];  then link='held by GUI'
        elif [ "$conn"  = "true" ]; then link='keeper (held)'
        else                             link='keeper: no device'
        fi
    else
        link='keeper stopped'
    fi

    # Mode is ours, not the device's, so it is readable either way: from the
    # keeper's last-applied state when the link is up, from the wish otherwise.
    if [ "$conn" = "true" ]; then
        auto=$(jq -r '.applied.auto // false' "$AQ_STATUS" 2>/dev/null)
    else
        auto=$(jq -r '.auto // false' "$AQ_DESIRED" 2>/dev/null)
    fi

    printf 'Aquaris\n\n'
    printf 'Link    : %s\n' "$link"
    case "$PLUG_STATE" in
        ON)  printf 'Plug    : on\n';;
        OFF) printf 'Plug    : OFF — no power\n';;
        '')  ;;                                    # no plug configured
        *)   printf 'Plug    : %s\n' "$PLUG_STATE";;
    esac
    if [ "$auto" = "true" ]; then
        printf 'Mode    : auto\n'
    else
        printf 'Mode    : manual\n'
        # Surface what the autopilot WOULD apply, so an off-but-wanted state is
        # obvious (e.g. auto-follow was turned off but tccd wants the fan on).
        local tw; tw=$(dj GetAquarisAutoTargetJSON 2>/dev/null | jq -r 'if (.enabled and .fanOn) then "auto wants \(.fanDutyCycle)%" else empty end' 2>/dev/null)
        [ -n "$tw" ] && printf '%s\n' "$tw"
    fi

    # No link => the device state is UNKNOWN. desired.json is a wish, not a
    # reading: printing it as fact once had this panel claiming "Cooling : ON"
    # while the unit had been unreachable — and, as it turned out, dark — for two
    # days. Show the wish as a wish, and let the Link line carry the bad news.
    if [ "$conn" != "true" ]; then
        fanOn=$(jq -r '.fanOn // false'      "$AQ_DESIRED" 2>/dev/null)
        fan=$(  jq -r '.fanDutyCycle // "?"' "$AQ_DESIRED" 2>/dev/null)
        ledOn=$(jq -r '.ledOn // false'      "$AQ_DESIRED" 2>/dev/null)
        if [ "$fanOn" = "true" ]; then wfan="fan ${fan}%"; else wfan='fan off'; fi
        if [ "$ledOn" = "true" ]; then wled='LED on';      else wled='LED off'; fi
        printf 'Cooling : unknown (no link)\n'
        printf 'LED     : unknown (no link)\n'
        printf 'Wanted  : %s, %s\n' "$wfan" "$wled"
        return
    fi

    # Link is up: reflect what is ACTUALLY on the device — the keeper's
    # last-applied state (this is what tccd's autopilot drives, via the keeper).
    fanOn=$(jq -r '.applied.fanOn // false'      "$AQ_STATUS" 2>/dev/null)
    fan=$(  jq -r '.applied.fanDutyCycle // "?"' "$AQ_STATUS" 2>/dev/null)
    ledOn=$(jq -r '.applied.ledOn // false'      "$AQ_STATUS" 2>/dev/null)
    r=$(jq -r '.applied.red // 0'   "$AQ_STATUS" 2>/dev/null)
    g=$(jq -r '.applied.green // 0' "$AQ_STATUS" 2>/dev/null)
    b=$(jq -r '.applied.blue // 0'  "$AQ_STATUS" 2>/dev/null)

    # Fan % lives on the Cooling line so a stale "last level" never shows when off.
    if [ "$fanOn" = "true" ]; then
        printf 'Cooling : ON  (%s%%)\n' "$fan"
    else
        printf 'Cooling : off\n'
    fi
    if [ "$ledOn" = "true" ]; then
        printf 'LED     : on  RGB(%s,%s,%s)\n' "$r" "$g" "$b"
    else
        printf 'LED     : off\n'
    fi
}

# ---- frame assembly --------------------------------------------------------------
fill() { local -n _arr=$1; while (( ${#_arr[@]} < $2 )); do _arr+=(''); done; }

# Two states need shouting about, and neither fits in the 28-column panel, so
# they go full-width above the columns (where `pad`'s character arithmetic can't
# be thrown off by escape sequences) in reverse video.
#
#   1. The plug is OFF — nothing downstream has power, including the laptop's
#      charging pass-through.
#   2. The keeper CUT a wedged Aquaris. The plug is switched back on straight
#      afterwards (the laptop is fed through it), so the plug reads ON and looks
#      normal — but the unit is dead until its front button is pressed, and there
#      is no cooling until then. Only keeper-state.json records this.
alert_block() {
    local conn killed
    if [ "$PLUG_STATE" = "OFF" ]; then
        printf '  \033[1;97;41m ⚠  AQUARIS HAS NO POWER — the plug is OFF \033[0m\n'
        printf '     Switch the plug on (s), then\n'
        printf "     \033[1mPRESS THE BUTTON on the unit's front.\033[0m\n\n"
        return 0
    fi
    conn=$(  jq -r '.connected // false'  "$AQ_STATUS"       2>/dev/null)
    killed=$(jq -r '.killedAtMs // empty' "$AQ_KEEPER_STATE" 2>/dev/null)
    [ "$conn" != "true" ] && [ -n "$killed" ] || return 0
    printf '  \033[1;97;41m ⚠  AQUARIS WAS SHUT DOWN — it had wedged \033[0m\n'
    printf '     The plug is on and the laptop is charging, but there\n'
    printf "     is NO COOLING: \033[1mPRESS THE BUTTON on the unit's front.\033[0m\n\n"
}

profile_digits() {
    local pcount; pcount=$(printf '%s' "$PROFILES" | jq 'length' 2>/dev/null) || pcount=0
    (( pcount > 9 )) && pcount=9
    printf '%d' "$pcount"
}

frame_mode() {
    case "$MODE" in narrow|wide) printf '%s' "$MODE"; return;; esac
    local cols; cols=$(tput cols 2>/dev/null) || cols=${COLUMNS:-80}
    if (( cols < FULL_W )); then printf 'narrow'; else printf 'wide'; fi
}

build_frame() {
    if [ "$(frame_mode)" = narrow ]; then build_frame_narrow; else build_frame_wide; fi
}

# narrow (< FULL_W columns, e.g. a 58-column SSH session): dashboard | profiles
# side by side (2+W1+3+W2 = 55 cols), Aquaris below, one-line key footer
build_frame_narrow() {
    local A B
    mapfile -t A < <(render_dash)
    mapfile -t B < <(render_profiles)
    local rows=${#A[@]}; (( ${#B[@]} > rows )) && rows=${#B[@]}

    printf '  白い熊 TUXEDO Control Center\n\n'
    alert_block
    local i
    for (( i = 0; i < rows; i++ )); do
        printf '  %s │ %s\n' "$(pad "${A[i]:-}" "$W1")" "$(pad "${B[i]:-}" "$W2")"
    done
    printf '\n'
    render_aquaris | while IFS= read -r line; do printf '  %s\n' "$line"; done
    printf '\n  q quit · 1-%s/p profile · a cool · f fan%% · l LED%s\n' \
        "$(profile_digits)" "$([ -n "$PLUG_IP" ] && printf ' · s plug')"
}

build_frame_wide() {
    local A B C
    mapfile -t A < <(render_dash)
    mapfile -t B < <(render_profiles)
    mapfile -t C < <(render_aquaris)

    # footers, bottom-aligned: every column ends on the "q quit" row, with at
    # least one blank line between the tallest body and its footer
    local digits; digits=$(profile_digits)
    local F1=('q quit')
    local F2=("1-${digits} set profile" 'p switch profile')
    local F3=('a cooling on/off' 'f fan % (Enter sets)' 'l LED on/off')
    [ -n "$PLUG_IP" ] && F3+=('s plug power on/off')

    local rows=$(( ${#A[@]} + 1 + ${#F1[@]} )) n
    n=$(( ${#B[@]} + 1 + ${#F2[@]} )); (( n > rows )) && rows=$n
    n=$(( ${#C[@]} + 1 + ${#F3[@]} )); (( n > rows )) && rows=$n
    fill A $(( rows - ${#F1[@]} )); A+=("${F1[@]}")
    fill B $(( rows - ${#F2[@]} )); B+=("${F2[@]}")
    fill C $(( rows - ${#F3[@]} )); C+=("${F3[@]}")

    printf '  白い熊 TUXEDO Control Center\n\n'
    alert_block
    local i
    for (( i = 0; i < rows; i++ )); do
        printf '  %s │ %s │ %s\n' "$(pad "${A[i]:-}" "$W1")" "$(pad "${B[i]:-}" "$W2")" "$(pad "${C[i]:-}" "$W3")"
    done
}

# ---- interactive actions -----------------------------------------------------------
# Prompts run in normal (cooked, echoing) mode at the bottom of the frame; the
# next refresh repaints over them.
prompt_profile() {
    tput cnorm 2>/dev/null
    printf '\n  switch to profile #: '
    local n; IFS= read -r n
    tput civis 2>/dev/null
    case "$n" in ''|*[!0-9]*) return;; esac
    switch_profile "$n"
}

switch_profile() {
    printf '\n  switching…'
    "$SELF_DIR/tccprofile" "$1" >/dev/null 2>&1   # sudo may prompt on the tty here
}

prompt_fan() {
    tput cnorm 2>/dev/null
    printf '\n  fan %%: '
    local n; IFS= read -r n
    tput civis 2>/dev/null
    case "$n" in ''|*[!0-9]*) return;; esac
    [ "$n" -le 100 ] || return
    "$SELF_DIR/tccaquaris" fan "$n" >/dev/null 2>&1
}

aq_toggle_cooling() {
    # Toggle relative to the ACTUAL running state (a manual toggle takes over
    # from the autopilot — tccaquaris on/off clears the auto-follow flag). With
    # no link there is no actual state, so toggle the wish instead — that is all
    # a keystroke can do until the device is back, and it is what will be applied.
    local on
    if [ "$(jq -r '.connected // false' "$AQ_STATUS" 2>/dev/null)" = "true" ]; then
        on=$(jq -r '.applied.fanOn // false' "$AQ_STATUS" 2>/dev/null)
    else
        on=$(jq -r '.fanOn // false' "$AQ_DESIRED" 2>/dev/null)
    fi
    if [ "$on" = "true" ]; then
        "$SELF_DIR/tccaquaris" off >/dev/null 2>&1
    else
        "$SELF_DIR/tccaquaris" on >/dev/null 2>&1
    fi
}

# Plug control. Switching OFF is destructive in a way no other key here is — it
# kills the Aquaris outright and only a walk to its front button undoes that — so
# it is confirmed. Switching ON is safe but insufficient, hence the reminder.
plug_set() {
    curl -s -m 3 "http://$PLUG_IP/cm?cmnd=Power%20$1" >/dev/null 2>&1
    PLUG_TS=0   # force a re-poll on the next frame
}

prompt_plug() {
    [ -n "$PLUG_IP" ] || return
    tput cnorm 2>/dev/null
    local a
    if [ "$PLUG_STATE" = "ON" ]; then
        printf '\n  Switch the plug OFF? This cuts power to the Aquaris, and it stays\n'
        printf '  off until you press the button on its front. [y/N]: '
        IFS= read -r a
        case "$a" in y|Y) plug_set Off;; esac
    else
        printf '\n  Switching the plug ON. Mains alone will not start the unit —\n'
        printf '  you must PRESS THE BUTTON on its front. [Enter]'
        IFS= read -r a
        plug_set On
    fi
    tput civis 2>/dev/null
}

aq_toggle_led() {
    if [ "$(jq -r '.ledOn // false' "$AQ_DESIRED" 2>/dev/null)" = "true" ]; then
        "$SELF_DIR/tccaquaris" led off >/dev/null 2>&1
    else
        "$SELF_DIR/tccaquaris" led on >/dev/null 2>&1
    fi
}

# ---- main loop ----------------------------------------------------------------------
cleanup() {
    tput cnorm 2>/dev/null
    printf '\n'
    sensors_restore
}
trap cleanup EXIT
trap 'exit 0' INT TERM

tput civis 2>/dev/null
printf '\033[H\033[2J\n  collecting sensor data…\n'
sensors_on
sleep 1.2

while :; do
    sensors_on   # keep-alive (tccd's 10 s timeout / GUI may switch it off)
    collect
    FRAME=$(build_frame)
    printf '\033[H%s\033[J' "$FRAME"
    KEY=''
    read -rsn1 -t "$INTERVAL" KEY || true
    case "$KEY" in
        q|Q) exit 0;;
        p|P) prompt_profile;;
        [1-9]) switch_profile "$KEY";;
        a|A) aq_toggle_cooling;;
        f|F) prompt_fan;;
        l|L) aq_toggle_led;;
        s|S) prompt_plug;;
    esac
done
